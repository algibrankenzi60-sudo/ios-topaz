+/* A zero absolute deadline is already due. The delayed-call queue forbids
+ * deadline zero, so enqueue J2's boot-graphics tick as immediate work. */
+static inline void
+vc_thread_call_enter_deadline(thread_call_t call, uint64_t deadline)
+{
+#if defined(J2PRIME)
+	if (deadline == 0) {
+		thread_call_enter(call);
+		return;
+	}
+#endif
+	thread_call_enter_delayed(call, deadline);
+}
