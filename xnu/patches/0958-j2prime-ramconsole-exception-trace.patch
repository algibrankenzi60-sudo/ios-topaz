new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/osfmk/arm64/j2prime_ramconsole.h
@@ -0,0 +1,22 @@
+#ifndef J2PRIME_RAMCONSOLE_H
+#define J2PRIME_RAMCONSOLE_H
+
+#include <stdint.h>
+
+#define J2_RAMCONSOLE_BASE 0x43f00000ULL
+#define J2_RAMCONSOLE_SIZE 0x10000u
+#define J2_RAMCONSOLE_SIG  0x43474244u
+#define J2_RAMCONSOLE_RR_MIN_SIZE 276u
+#define J2_RAMCONSOLE_RR_ALIGNMENT 64u
+#define J2_RAMCONSOLE_FIQ_STEP_OFFSET 272u
+
+extern volatile uint32_t j2prime_early_exception_phase;
+void j2prime_ramconsole_mark(uint32_t stage);
+void j2prime_ramconsole_relocate(uintptr_t mapped_base);
+void j2prime_early_exception_set_phase(uint32_t phase);
+void j2prime_early_exception_install(void);
+void j2prime_early_exception_restore(void);
+void j2prime_early_exception_record(uint64_t esr, uint64_t elr,
+    uint64_t far, uint64_t spsr) __attribute__((noreturn));
+
+#endif
diff --git a/osfmk/arm64/j2prime_ramconsole.c b/osfmk/arm64/j2prime_ramconsole.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/osfmk/arm64/j2prime_ramconsole.c
@@ -0,0 +1,226 @@
+/* J2 Prime early progress/exception marker in Samsung's reserved RAM console. */
+#include "j2prime_ramconsole.h"
+
+struct j2_ramconsole_header {
+	uint32_t sig;
+	uint32_t off_pl;
+	uint32_t off_lpl;
+	uint32_t sz_pl;
+	uint32_t off_lk;
+	uint32_t off_llk;
+	uint32_t sz_lk;
+	uint32_t padding[3];
+	uint32_t sz_buffer;
+	uint32_t off_linux;
+	uint32_t off_console;
+	uint32_t log_start;
+	uint32_t log_size;
+	uint32_t sz_console;
+};
+
+struct j2_sec_last_reboot_reason {
+	uint32_t is_upload;
+	uint32_t upload_reason;
+	uint32_t is_power_reset;
+	uint32_t power_reset_reason;
+	char panic_str[256];
+	uint32_t fiq_step;
+};
+
+volatile uint32_t j2prime_early_exception_phase;
+static uintptr_t j2prime_ramconsole_active_base = (uintptr_t)J2_RAMCONSOLE_BASE;
+#ifndef J2_RAMCONSOLE_HOST_TEST
+static uint64_t j2prime_saved_vbar;
+static uint64_t j2prime_saved_daif;
+#endif
+
+static volatile struct j2_sec_last_reboot_reason *
+j2_ramconsole_reason(uintptr_t base)
+{
+	if (base == 0) {
+		return 0;
+	}
+	volatile struct j2_ramconsole_header *h =
+	    (volatile struct j2_ramconsole_header *)base;
+
+	/* Refuse writes unless the live Samsung header proves this exact ABI. */
+	if (h->sig != J2_RAMCONSOLE_SIG || h->sz_buffer != J2_RAMCONSOLE_SIZE ||
+	    h->off_linux > h->sz_buffer || h->off_console > h->sz_buffer ||
+	    h->off_console < h->off_linux ||
+	    h->off_console - h->off_linux < J2_RAMCONSOLE_RR_MIN_SIZE ||
+	    (h->off_console - h->off_linux) % J2_RAMCONSOLE_RR_ALIGNMENT != 0 ||
+	    h->sz_console != h->sz_buffer - h->off_console ||
+	    h->log_start > h->sz_console || h->log_size > h->sz_console) {
+		return 0;
+	}
+
+	return (volatile struct j2_sec_last_reboot_reason *)
+	    ((uintptr_t)h + h->off_linux);
+}
+
+static void
+j2_store_marker(uintptr_t base, uint32_t value)
+{
+	volatile struct j2_sec_last_reboot_reason *rr = j2_ramconsole_reason(base);
+	if (rr == 0) {
+		return;
+	}
+	rr->fiq_step = value;
+	/* The bootstrap maps this reserved region as write-combined memory. */
+#if defined(__aarch64__)
+	__asm__ volatile("dsb sy" ::: "memory");
+#else
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+}
+
+static uint32_t
+j2_append_console_line(uintptr_t base, const char *line, uint32_t length)
+{
+	volatile struct j2_ramconsole_header *h =
+	    (volatile struct j2_ramconsole_header *)base;
+	if (j2_ramconsole_reason(base) == 0 || length == 0 ||
+	    h->log_start != h->log_size || h->log_size > h->sz_console ||
+	    length > h->sz_console - h->log_size) {
+		return 0;
+	}
+	volatile char *out = (volatile char *)(base + h->off_console + h->log_start);
+	for (uint32_t i = 0; i < length; ++i) {
+		out[i] = line[i];
+	}
+#if defined(__aarch64__)
+	__asm__ volatile("dsb sy" ::: "memory");
+#else
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+	/* Publish size first so an interrupted update still has a valid header. */
+	h->log_size += length;
+#if defined(__aarch64__)
+	__asm__ volatile("dsb sy" ::: "memory");
+#else
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+	h->log_start += length;
+#if defined(__aarch64__)
+	__asm__ volatile("dsb sy" ::: "memory");
+#else
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+	return 1;
+}
+
+static uint32_t
+j2_append_string(char *out, uint32_t offset, const char *text)
+{
+	while (*text) out[offset++] = *text++;
+	return offset;
+}
+
+static uint32_t
+j2_append_hex64(char *out, uint32_t offset, uint64_t value)
+{
+	static const char digits[] = "0123456789abcdef";
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		out[offset++] = digits[(value >> shift) & 0xfu];
+	}
+	return offset;
+}
+
+static uint32_t
+j2_format_exception(char *out, uint32_t phase, uint64_t esr,
+    uint64_t elr, uint64_t far, uint64_t spsr)
+{
+	uint32_t n = 0;
+	n = j2_append_string(out, n, "J2XNU EXC phase=");
+	n = j2_append_hex64(out, n, phase);
+	n = j2_append_string(out, n, " ESR=");
+	n = j2_append_hex64(out, n, esr);
+	n = j2_append_string(out, n, " ELR=");
+	n = j2_append_hex64(out, n, elr);
+	n = j2_append_string(out, n, " FAR=");
+	n = j2_append_hex64(out, n, far);
+	n = j2_append_string(out, n, " SPSR=");
+	n = j2_append_hex64(out, n, spsr);
+	out[n++] = '\n';
+	return n;
+}
+
+void
+j2prime_ramconsole_mark(uint32_t stage)
+{
+	if (stage <= 0xffu) {
+		j2_store_marker(j2prime_ramconsole_active_base, 0x4a320000u | stage);
+	}
+}
+
+/* Switch from the bootstrap identity VA to the explicit TTBR1 block alias. */
+void
+j2prime_ramconsole_relocate(uintptr_t mapped_base)
+{
+	j2prime_ramconsole_active_base = mapped_base;
+#if defined(__aarch64__)
+	__asm__ volatile("dsb sy\n\tisb" ::: "memory");
+#else
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+}
+
+void
+j2prime_early_exception_set_phase(uint32_t phase)
+{
+	j2prime_early_exception_phase = phase;
+#if defined(__aarch64__)
+	__asm__ volatile("dsb ishst" ::: "memory");
+#else
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+}
+
+static uint32_t
+j2_exception_marker(uint64_t esr, uint32_t phase)
+{
+	uint32_t ec = (uint32_t)((esr >> 26) & 0x3fu);
+	return 0x4a2e0000u | (ec << 8) | (phase & 0xffu);
+}
+
+#ifndef J2_RAMCONSOLE_HOST_TEST
+extern void j2prime_early_vectors(void);
+
+void
+j2prime_early_exception_install(void)
+{
+	uint64_t vectors = (uint64_t)(uintptr_t)j2prime_early_vectors;
+	__asm__ volatile("mrs %0, vbar_el1" : "=r"(j2prime_saved_vbar));
+	__asm__ volatile("mrs %0, daif" : "=r"(j2prime_saved_daif));
+	/* Mask debug/IRQ/FIQ during the short instrumented transition. */
+	__asm__ volatile("msr daifset, #11\n\tmsr vbar_el1, %0\n\tisb"
+	    :: "r"(vectors) : "memory");
+}
+
+void
+j2prime_early_exception_restore(void)
+{
+	__asm__ volatile("msr vbar_el1, %0\n\tisb\n\tmsr daif, %1\n\tisb"
+	    :: "r"(j2prime_saved_vbar), "r"(j2prime_saved_daif) : "memory");
+}
+
+void
+j2prime_early_exception_record(uint64_t esr, uint64_t elr,
+    uint64_t far, uint64_t spsr)
+{
+	uint32_t phase = j2prime_early_exception_phase & 0xffu;
+	char line[128];
+	/* The header marker always survives; full registers append only into free ring space. */
+	uintptr_t base = j2prime_ramconsole_active_base;
+	j2_store_marker(base,
+	    j2_exception_marker(esr, phase));
+	uint32_t length = j2_format_exception(line, phase, esr, elr, far, spsr);
+	(void)j2_append_console_line(base, line, length);
+	for (;;) {
+		__asm__ volatile("wfi" ::: "memory");
+	}
+}
+#else
+void j2prime_early_exception_install(void) {}
+void j2prime_early_exception_restore(void) {}
+#endif
