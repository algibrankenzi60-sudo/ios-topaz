+_j2prime_early_vectors:
+.macro J2_EARLY_VECTOR
+	b	_j2prime_early_exception_entry
+	.space	124
+.endmacro
+.rept 16
+	J2_EARLY_VECTOR
+.endr
+
+_j2prime_early_exception_entry:
+	mrs	x0, esr_el1
+	mrs	x1, elr_el1
+	mrs	x2, far_el1
+	mrs	x3, spsr_el1
+	b	_j2prime_early_exception_record
