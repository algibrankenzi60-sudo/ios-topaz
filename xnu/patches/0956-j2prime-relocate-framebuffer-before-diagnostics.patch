 	sweet_early_mark(8, "leaving bootstrap TTBR0");
 	early_fb = (volatile uint32_t *)(uintptr_t)base;
 	__asm__ volatile("dsb sy" ::: "memory");
+#endif
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
 
