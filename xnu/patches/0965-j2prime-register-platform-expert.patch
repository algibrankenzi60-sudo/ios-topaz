+/*
+ * Device-tree platform expert for the Samsung Galaxy J2 Prime (SM-G532G).
+ * This uses XNU's generic ARM IODTPlatformExpert and publishes only nodes
+ * actually present in the supplied J2 ADT. It does not emulate Apple hardware.
+ */
+#include <pexpert/arm64/board_config.h>
+#include <arm64/sweet_early.h>
+
+#if defined(J2PRIME)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class J2PrimePlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(J2PrimePlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(J2PrimePlatformExpert, IODTPlatformExpert);
+
+bool
+J2PrimePlatformExpert::start(IOService *provider)
+{
+	sweet_early_mark(16, "J2 expert start entered");
+	IOLog("J2PRIME: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		sweet_early_mark(17, "J2 base expert start failed");
+		return false;
+	}
+	sweet_early_mark(17, "J2 base expert start returned");
+	registerService();
+	sweet_early_mark(18, "J2 expert registered");
+	IOLog("J2PRIME: platform expert registered\n");
+	return true;
+}
+
+const char *
+J2PrimePlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+J2PrimePlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+J2PrimePlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	sweet_early_mark(19, "J2 processTopLevel entered");
+	/* XNU's stock path expects Apple NVRAM. Preserve the real ADT nodes. */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+
+	/* The J2 ADT has only the GIC under arm-io; its driver stays platform-owned. */
+	IORegistryEntry *armio = root->childFromPath("arm-io", gIODTPlane);
+	if (armio != NULL) {
+		createNubs(this, IODTFindMatchingEntries(armio, kIODTExclusive, "('gic')"));
+		armio->release();
+	}
+	sweet_early_mark(20, "J2 processTopLevel done");
+}
+#endif /* J2PRIME */
