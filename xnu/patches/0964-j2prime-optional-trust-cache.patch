diff --git a/bsd/kern/kern_trustcache.c b/bsd/kern/kern_trustcache.c
index 9066367..12bf5d0 100755
--- a/bsd/kern/kern_trustcache.c
+++ b/bsd/kern/kern_trustcache.c
@@ -248,17 +248,21 @@ trust_cache_runtime_init(void)
 	allow_legacy_caches = true;
 #endif
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(J2PRIME)
 	/*
-	 * Standalone SWEET bring-up has no AppleImage4/AMFI kexts. Represent
-	 * the missing service explicitly: no caches can be loaded or matched.
-	 * Keep a NULL runtime through lockdown rather than a partially
-	 * initialized runtime that would later dereference absent callbacks.
+	 * Standalone SWEET/J2PRIME bring-up has no AppleImage4/AMFI kexts.
+	 * Represent the missing service explicitly: no caches can be loaded
+	 * or matched. Keep a NULL runtime rather than dereferencing absent
+	 * callbacks during trust-cache lockdown.
 	 */
 	if (img4if == NULL || amfi == NULL) {
 		trust_cache_rt = NULL;
 		trust_cache_mut_rt = NULL;
+#if defined(J2PRIME)
+		printf("J2PRIME: trust caches unavailable (Image4/AMFI not installed)\n");
+#else
 		printf("SWEET: trust caches unavailable (Image4/AMFI not installed)\n");
+#endif
 		return;
 	}
 #endif
@@ -493,7 +497,7 @@ check_trust_cache_runtime_for_uuid(
 		return KERN_INVALID_ARGUMENT;
 	}
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(J2PRIME)
 	if (trust_cache_rt == NULL) {
 		return KERN_NOT_FOUND;
 	}
@@ -583,7 +587,7 @@ load_trust_cache_with_type(
 		}
 	}
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(J2PRIME)
 	if (trust_cache_rt == NULL) {
 		return KERN_NOT_SUPPORTED;
 	}
@@ -695,7 +699,7 @@ load_legacy_trust_cache(
 		panic("overflow on the module: %p | %lu", module_data, module_size);
 	}
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(J2PRIME)
 	if (trust_cache_rt == NULL) {
 		return KERN_NOT_SUPPORTED;
 	}
@@ -729,7 +733,7 @@ query_trust_cache(
 		return KERN_INVALID_ARGUMENT;
 	}
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(J2PRIME)
 	if (trust_cache_rt == NULL) {
 		if (query_type >= kTCQueryTypeTotal) {
 			return KERN_INVALID_ARGUMENT;
@@ -946,7 +950,7 @@ static_trust_cache_capabilities(
 	*capabilities0_ret = kTCCapabilityNone;
 	*capabilities1_ret = kTCCapabilityNone;
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(J2PRIME)
 	if (trust_cache_rt == NULL) {
 		return KERN_NOT_SUPPORTED;
 	}
