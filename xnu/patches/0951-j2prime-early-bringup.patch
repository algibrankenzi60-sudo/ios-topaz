+ * Minimal single-core XNU bring-up configuration; this is not a full SoC port.
+ */
+#ifndef _PEXPERT_ARM64_J2PRIME_H
+#define _PEXPERT_ARM64_J2PRIME_H
+
+#define NO_MONITOR                    1
+#define NO_ECORE                      1
+#define J2PRIME                       1
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__                  8
+#define __ARM_VMSA__                  8
+#define __ARM_VFP__                   4
+#define __ARM_COHERENT_CACHE__        1
+#define __ARM_DEBUG__                 7
+#define __ARM_ENABLE_SWAP__           1
+#define __ARM_V8_CRYPTO_EXTENSIONS__  1
+#define HAS_GIC_V3                    0
+#define HAS_GIC_V2                    1
+#define J2_VTIMER_INTID               27
+#define GIC_SPURIOUS_IRQ              1023
+#define J2_GICD_PBASE                 0x10221000ULL
+#define J2_GICC_PBASE                 0x10222000ULL
+#define J2_GIC_MMIO_SIZE              0x10000ULL
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif
+
+#endif /* _PEXPERT_ARM64_J2PRIME_H */
