diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -222,6 +222,80 @@
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif defined(J2PRIME)
+/* MT6737T uses the memory-mapped MTK GIC CPU interface (GICv2 style). */
+#define J2_GICD_CTLR          0x000
+#define J2_GICD_CTLR_ENABLEGRP1  (1U << 1)
+#define J2_GICD_IGROUPR0      0x080
+#define J2_GICD_ISENABLER0    0x100
+#define J2_GICD_ICENABLER0    0x180
+#define J2_GICD_IPRIORITYR0   0x400
+#define J2_GICC_CTLR          0x000
+#define J2_GICC_CTLR_ENABLEGRP1 (1U << 1)
+#define J2_GICC_PMR           0x004
+#define J2_GICC_BPR           0x008
+#define J2_GICC_IAR           0x00c
+#define J2_GICC_EOIR          0x010
+
+static vm_offset_t j2_gicd_base;
+static vm_offset_t j2_gicc_base;
+
+static uint32_t
+j2_gic_read32(vm_offset_t base, uint32_t offset)
+{
+	return *((volatile uint32_t *)(base + offset));
+}
+
+static void
+j2_gic_write32(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+	*((volatile uint32_t *)(base + offset)) = value;
+}
+
+uint32_t
+j2_gicv2_ack_irq(void)
+{
+	return j2_gic_read32(j2_gicc_base, J2_GICC_IAR);
+}
+
+void
+j2_gicv2_eoi(uint32_t iar)
+{
+	j2_gic_write32(j2_gicc_base, J2_GICC_EOIR, iar);
+	__builtin_arm_dsb(DSB_SY);
+}
+
+void
+pe_init_fiq(void)
+{
+	j2_gicd_base = ml_io_map(J2_GICD_PBASE, J2_GIC_MMIO_SIZE);
+	j2_gicc_base = ml_io_map(J2_GICC_PBASE, J2_GIC_MMIO_SIZE);
+	if (!j2_gicd_base || !j2_gicc_base) {
+		panic("J2 GIC: failed to map distributor or CPU interface");
+	}
+
+	/* Stop this CPU interface while setting up its banked timer PPI. */
+	j2_gic_write32(j2_gicc_base, J2_GICC_CTLR, 0);
+	j2_gic_write32(j2_gicd_base, J2_GICD_ICENABLER0, 1U << J2_VTIMER_INTID);
+
+	/* Group 1 Non-secure, with a normal interrupt priority. */
+	uint32_t groups = j2_gic_read32(j2_gicd_base, J2_GICD_IGROUPR0);
+	j2_gic_write32(j2_gicd_base, J2_GICD_IGROUPR0, groups | (1U << J2_VTIMER_INTID));
+	uint32_t priority_offset = J2_GICD_IPRIORITYR0 + (J2_VTIMER_INTID & ~3U);
+	uint32_t priority_shift = (J2_VTIMER_INTID & 3U) * 8U;
+	uint32_t priorities = j2_gic_read32(j2_gicd_base, priority_offset);
+	priorities = (priorities & ~(0xffU << priority_shift)) | (0xa0U << priority_shift);
+	j2_gic_write32(j2_gicd_base, priority_offset, priorities);
+	j2_gic_write32(j2_gicd_base, J2_GICD_ISENABLER0, 1U << J2_VTIMER_INTID);
+	j2_gic_write32(j2_gicd_base, J2_GICD_CTLR,
+	    j2_gic_read32(j2_gicd_base, J2_GICD_CTLR) | J2_GICD_CTLR_ENABLEGRP1);
+
+	j2_gic_write32(j2_gicc_base, J2_GICC_BPR, 0);
+	j2_gic_write32(j2_gicc_base, J2_GICC_PMR, 0xff);
+	j2_gic_write32(j2_gicc_base, J2_GICC_CTLR, J2_GICC_CTLR_ENABLEGRP1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
